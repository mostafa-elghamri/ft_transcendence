<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Friends</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
        }

        .friends-container {
            width: 500px;
            max-width: 90%;
            margin: 50px auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .friends-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .friends-header h2 {
            margin: 0;
        }

        #friendsCount {
            background: #eee;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 14px;
        }

        .friend-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            margin-bottom: 10px;
            background: #f8f8f8;
            border-radius: 10px;
        }

        .friend-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .friend-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .friend-name {
            font-weight: bold;
            margin-bottom: 4px;
        }

        .friend-email {
            color: #777;
            font-size: 13px;
        }

        .remove-button {
            border: none;
            background: #eee;
            padding: 8px 12px;
            border-radius: 7px;
            cursor: pointer;
        }

        .remove-button:hover {
            background: #ddd;
        }

        .no-friends {
            text-align: center;
            color: #777;
            padding: 30px 0;
        }
    </style>
</head>

<body>

    <div class="friends-container">

        <div class="friends-header">
            <h2>My Friends</h2>

            <span id="friendsCount">
                0
            </span>
        </div>

        <div id="friendsList">

            <p class="no-friends">
                Loading friends...
            </p>

        </div>

    </div>


    <script>

        /*
         * Current user
         */

        const currentUserId =
            "6aa186c9cee849c379ddab38";


        const friendsList =
            document.getElementById("friendsList");

        const friendsCount =
            document.getElementById("friendsCount");


        /*
         * Load friends
         */

        async function loadFriends() {

            try {

                const response =
                    await fetch(
                        `/api/friends?userId=${currentUserId}`
                    );

                const data =
                    await response.json();

                if (!response.ok) {
                    throw new Error(data.message);
                }

                renderFriends(data.friends);

            } catch (error) {

                console.error(
                    "Error loading friends:",
                    error
                );

                friendsList.innerHTML = `
                    <p class="no-friends">
                        Failed to load friends
                    </p>
                `;
            }
        }


        /*
         * Render friends
         */

        function renderFriends(friends) {

            friendsList.innerHTML = "";

            friendsCount.textContent =
                friends.length;


            if (friends.length === 0) {

                friendsList.innerHTML = `
                    <p class="no-friends">
                        You don't have any friends yet.
                    </p>
                `;

                return;
            }


            friends.forEach(friend => {

                const div =
                    document.createElement("div");

                div.classList.add("friend-item");


                const firstLetter =
                    friend.username
                        ? friend.username
                            .charAt(0)
                            .toUpperCase()
                        : "?";


                div.innerHTML = `

                    <div class="friend-info">

                        <div class="friend-avatar">
                            ${firstLetter}
                        </div>

                        <div>

                            <div class="friend-name">
                                ${friend.username}
                            </div>

                            <div class="friend-email">
                                ${friend.useremail}
                            </div>

                        </div>

                    </div>


                    <button
                        class="remove-button"
                        data-id="${friend._id}">
                        Remove
                    </button>

                `;


                const removeButton =
                    div.querySelector(
                        ".remove-button"
                    );


                removeButton.addEventListener(
                    "click",
                    () => {

                        removeFriend(
                            friend._id
                        );

                    }
                );


                friendsList.appendChild(div);

            });
        }


        /*
         * Remove friend
         */

        async function removeFriend(friendId) {

            try {

                const response =
                    await fetch(
                        "/api/friends",
                        {
                            method: "DELETE",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                userId: currentUserId,
                                friendId: friendId
                            })
                        }
                    );


                const data =
                    await response.json();


                if (!response.ok) {
                    throw new Error(data.message);
                }


                /*
                 * Reload list
                 */

                loadFriends();


            } catch (error) {

                console.error(
                    "Error removing friend:",
                    error
                );
            }
        }


        /*
         * Start
         */

        loadFriends();

    </script>

</body>

</html>