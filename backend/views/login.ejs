<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Splitifyr — Log in or sign up</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: #10B981;
    --primary-dark: #0D9668;
    --dark: #0F172A;
    --dark-2: #16213A;
    --gray: #64748B;
    --gray-light: #94A3B8;
    --light: #F1F5F9;
    --danger: #EF4444;
    --warning: #F59E0B;
    --border: #E2E8F0;
    --white: #FFFFFF;

    --h1: 24px;
    --h2: 20px;
    --h3: 16px;
    --body: 14px;
    --small: 12px;

    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  * { box-sizing: inherit; }

  html {
    scroll-padding-top: env(safe-area-inset-top, 0px);
  }

  html, body {
    height: 100%;
    margin: 0;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--dark);
    color: var(--dark);
    font-size: var(--body);
    line-height: 1.5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    min-height: 100%;
  }

  .card {
    width: 100%;
    max-width: 920px;
    min-height: 600px;
    background: var(--white);
    border-radius: 20px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    box-shadow: 0 30px 80px -20px rgba(0,0,0,0.5);
  }

  /* -------- Left panel: brand + illustration -------- */

  .brand-panel {
    position: relative;
    background: linear-gradient(165deg, var(--dark) 0%, var(--dark-2) 55%, #0B3B33 100%);
    color: var(--white);
    padding: 44px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .brand-top {
    position: relative;
    z-index: 2;
  }

  .logo-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .logo-mark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-mark svg { width: 18px; height: 18px; }

  .logo-text {
    font-size: var(--h2);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-tagline {
    font-size: var(--h3);
    font-weight: 500;
    color: var(--gray-light);
    max-width: 220px;
  }

  .brand-bottom {
    position: relative;
    z-index: 2;
  }

  .brand-bottom h2 {
    font-size: var(--h1);
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .brand-bottom p {
    margin: 0;
    font-size: var(--body);
    color: var(--gray-light);
    max-width: 260px;
  }

  .illustration {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* -------- Right panel: forms -------- */

  .form-panel {
    padding: 48px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  .view {
    display: none;
    animation: rise 0.35s ease;
  }

  .view.active { display: block; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .view h1 {
    font-size: var(--h1);
    font-weight: 700;
    margin: 0 0 6px;
    color: var(--dark);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .view .subtitle {
    font-size: var(--body);
    color: var(--gray);
    margin: 0 0 28px;
  }

  .field {
    margin-bottom: 18px;
  }

  .field label {
    display: block;
    font-size: var(--small);
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 6px;
  }

  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-wrap svg.icon-left {
    position: absolute;
    left: 14px;
    width: 16px;
    height: 16px;
    color: var(--gray);
    pointer-events: none;
  }

  .input-wrap input {
    width: 100%;
    padding: 12px 14px 12px 40px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-size: var(--body);
    font-family: inherit;
    color: var(--dark);
    background: var(--white);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .input-wrap input::placeholder { color: var(--gray-light); }

  .input-wrap input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
  }

  .input-wrap input:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  .toggle-visibility {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: var(--gray);
    display: flex;
  }

  .toggle-visibility:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .toggle-visibility svg { width: 17px; height: 17px; }

  .row-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    font-size: var(--small);
  }

  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    color: var(--gray);
    font-size: var(--small);
    user-select: none;
  }

  .checkbox-row input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--border);
    border-radius: 5px;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
  }

  .checkbox-row input[type="checkbox"]:checked {
    background: var(--primary);
    border-color: var(--primary);
  }

  .checkbox-row input[type="checkbox"]:checked::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 1px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-row input[type="checkbox"]:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  a.link {
    color: var(--primary-dark);
    text-decoration: none;
    font-weight: 600;
  }

  a.link:hover { text-decoration: underline; }

  .btn-primary {
    width: 100%;
    padding: 13px;
    background: var(--primary);
    color: var(--white);
    border: none;
    border-radius: 10px;
    font-size: var(--body);
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-primary:hover { background: var(--primary-dark); }

  .btn-primary:focus-visible {
    outline: 2px solid var(--dark);
    outline-offset: 2px;
  }

  .switch-line {
    text-align: center;
    margin-top: 22px;
    font-size: var(--body);
    color: var(--gray);
  }

  .hint {
    font-size: var(--small);
    color: var(--gray);
    margin-top: -10px;
    margin-bottom: 18px;
  }

  .hint.weak { color: var(--danger); }
  .hint.strong { color: var(--primary-dark); }

  .name-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  @media (max-width: 760px) {
    body { padding: 0; }
    .card {
      grid-template-columns: 1fr;
      border-radius: 0;
      min-height: 100vh;
      min-height: 100%;
    }
    .brand-panel {
      padding: 32px 28px 40px;
      min-height: 220px;
    }
    .brand-bottom h2 { font-size: var(--h2); }
    .brand-bottom p { display: none; }
    .form-panel { padding: 36px 28px 48px; }
    .name-grid { grid-template-columns: 1fr; gap: 0; }
  }

  :root:not([data-theme="light"]) {
    color-scheme: dark;
  }
</style>
</head>
<body>

<div class="card">

  <!-- LEFT: brand + illustration -->
  <div class="brand-panel">
    <div class="brand-top">
      <div class="logo-row">
        <span class="logo-mark">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8" cy="8" r="3" stroke="white" stroke-width="1.8"/>
            <circle cx="16" cy="8" r="3" stroke="white" stroke-width="1.8"/>
            <path d="M3 20c0-3.3 2.2-5.5 5-5.5s5 2.2 5 5.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M11 20c0-3.3 2.2-5.5 5-5.5s5 2.2 5 5.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="logo-text">Splitify</span>
      </div>
      <p class="brand-tagline">Split expenses. Stay together.</p>
    </div>

    <svg class="illustration" viewBox="0 0 460 640" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0F172A" stop-opacity="0"/>
          <stop offset="100%" stop-color="#0B3B33" stop-opacity="0.5"/>
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="460" height="640" fill="url(#sky)"/>
      <circle cx="360" cy="150" r="46" fill="#F59E0B" opacity="0.13"/>
      <path d="M-20 430 L110 300 L190 380 L260 260 L340 370 L480 260 L480 640 L-20 640 Z" fill="#0B3B33" opacity="0.9"/>
      <path d="M-20 480 L90 380 L170 440 L250 340 L330 430 L480 330 L480 640 L-20 640 Z" fill="#0F4A3F" opacity="0.9"/>
      <path d="M-20 540 L120 440 L210 500 L300 420 L390 500 L480 440 L480 640 L-20 640 Z" fill="#14574A" opacity="0.95"/>
      <path d="M40 640 C 90 560, 150 560, 190 480 C 230 400, 290 420, 320 360 C 350 300, 400 300, 430 260" stroke="#D9E8E2" stroke-width="14" stroke-linecap="round" fill="none" opacity="0.5"/>
      <g opacity="0.85">
        <path d="M70 560 l14 -34 l14 34 z" fill="#0B3B33"/>
        <path d="M70 575 l17 -40 l17 40 z" fill="#0F4A3F"/>
        <rect x="82" y="575" width="6" height="14" fill="#3F2E22"/>
        <path d="M370 480 l12 -30 l12 30 z" fill="#0B3B33"/>
        <path d="M370 495 l15 -36 l15 36 z" fill="#0F4A3F"/>
        <rect x="380" y="495" width="6" height="12" fill="#3F2E22"/>
      </g>
    </svg>

    <div class="brand-bottom">
      <h2>Together we spend, better.</h2>
      <p>Create groups, add expenses, track balances, and chat with your friends — all in one place.</p>
    </div>
  </div>

  <!-- RIGHT: forms -->
  <div class="form-panel">

    <!-- LOGIN VIEW -->
    <div class="view active" id="login-view">
      <h1>Welcome back <span aria-hidden="true">👋</span></h1>
      <p class="subtitle">Log in to your account</p>

      <form onsubmit="return false;">
        <div class="field">
          <label for="login-email">Email address</label>
          <div class="input-wrap">
            <svg class="icon-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6" stroke-linecap="round"/></svg>
            <input id="login-email" type="email" placeholder="you@example.com" autocomplete="email" required>
          </div>
        </div>

        <div class="field">
          <label for="login-password">Password</label>
          <div class="input-wrap">
            <svg class="icon-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
            <input id="login-password" type="password" placeholder="••••••••" autocomplete="current-password" required>
            <button type="button" class="toggle-visibility" aria-label="Show password" onclick="togglePassword('login-password', this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <div class="row-between">
          <label class="checkbox-row">
            <input type="checkbox" checked>
            Remember me
          </label>
          <a href="#" class="link">Forgot password?</a>
        </div>

        <button type="submit" class="btn-primary">Log in</button>
      </form>

      <p class="switch-line">Don't have an account? <a href="#" class="link" onclick="showView('signup')">Sign up</a></p>
    </div>

    <!-- SIGNUP VIEW -->
    <div class="view" id="signup-view">
      <h1>Create your account</h1>
      <p class="subtitle">Start splitting expenses with your people</p>

      <form id="signup-form">
        <div class="field">
          <label for="signup-name">Full name</label>
          <div class="input-wrap">
            <svg class="icon-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" stroke-linecap="round"/></svg>
            <input id="signup-name" name="name" type="text" placeholder="Mohamed El Aidi" autocomplete="name" required>
          </div>
        </div>

        <div class="field">
          <label for="signup-email">Email address</label>
          <div class="input-wrap">
            <svg class="icon-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6" stroke-linecap="round"/></svg>
            <input id="signup-email" type="email" placeholder="you@example.com" autocomplete="email" required>
          </div>
        </div>

        <div class="field">
          <label for="signup-password">Password</label>
          <div class="input-wrap">
            <svg class="icon-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
            <input id="signup-password" type="password" placeholder="At least 8 characters" autocomplete="new-password" required minlength="8" oninput="updateStrength(this.value)">
            <button type="button" class="toggle-visibility" aria-label="Show password" onclick="togglePassword('signup-password', this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <p class="hint" id="strength-hint">Use 8+ characters with a number or symbol</p>

        <div class="field">
          <label for="signup-confirm">Confirm password</label>
          <div class="input-wrap">
            <svg class="icon-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
            <input id="signup-confirm" type="password" placeholder="••••••••" autocomplete="new-password" required>
            <button type="button" class="toggle-visibility" aria-label="Show password" onclick="togglePassword('signup-confirm', this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <div class="row-between" style="margin-bottom:22px;">
          <label class="checkbox-row">
            <input type="checkbox" required>
            I agree to the <a href="#" class="link" style="margin-left:3px;">Terms</a>&nbsp;&&nbsp;<a href="#" class="link">Privacy Policy</a>
          </label>
        </div>

        <button type="submit" class="btn-primary">Create account</button>
      </form>

      <p class="switch-line">Already have an account? <a href="#" class="link" onclick="showView('login')">Log in</a></p>
    </div>

  </div>
</div>

<script>
  function showView(name) {
    document.getElementById('login-view').classList.toggle('active', name === 'login');
    document.getElementById('signup-view').classList.toggle('active', name === 'signup');
  }

  function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
  }

  function updateStrength(value) {
    const hint = document.getElementById('strength-hint');
    if (!value) {
      hint.textContent = 'Use 8+ characters with a number or symbol';
      hint.className = 'hint';
      return;
    }
    const hasNumberOrSymbol = /[0-9]/.test(value) || /[^A-Za-z0-9]/.test(value);
    if (value.length >= 8 && hasNumberOrSymbol) {
      hint.textContent = 'Good password strength';
      hint.className = 'hint strong';
    } else {
      hint.textContent = 'Use 8+ characters with a number or symbol';
      hint.className = 'hint weak';
    }
  }
</script>

</body>
</html>
