<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Expense</title>
    <style>
        * { box-sizing: border-box; font-family: Arial, sans-serif; }
        body { max-width: 600px; margin: 40px auto; padding: 20px; }
        h1 { color: #333; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input, select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
        .radio-group { display: flex; gap: 20px; }
        .radio-group label { display: flex; align-items: center; gap: 5px; font-weight: normal; }
        .participant-row { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; padding: 10px; background: #f5f5f5; border-radius: 4px; }
        .participant-row input { flex: 1; }
        .remove-btn { background: #e74c3c; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; }
        .add-btn, .submit-btn { background: #27ae60; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-size: 16px; }
        .add-btn { background: #3498db; margin-top: 10px; }
        .total-info { background: #ecf0f1; padding: 10px; border-radius: 4px; margin-top: 10px; }
    </style>
</head>
<body>
    <h1>Create Expense</h1>
    
    <form action="/expenses" method="POST">
        <!-- Group ID -->
        <div class="form-group">
            <label for="groupId">Group ID</label>
            <input type="text" id="groupId" name="groupId" placeholder="Paste group ObjectId here" required>
        </div>

        <!-- Amount -->
        <div class="form-group">
            <label for="amount">Amount</label>
            <input type="number" id="amount" name="amount" step="0.01" min="0.01" required>
        </div>

        <!-- Description -->
        <div class="form-group">
            <label for="description">Description</label>
            <input type="text" id="description" name="description" placeholder="e.g., Dinner at restaurant">
        </div>

        <!-- Split Method -->
        <div class="form-group">
            <label>Split Method</label>
            <div class="radio-group">
                <label>
                    <input type="radio" name="splitMethod" value="equal" checked onchange="updateSplitMethod()">
                    Equal Split
                </label>
                <label>
                    <input type="radio" name="splitMethod" value="custom" onchange="updateSplitMethod()">
                    Custom Amounts
                </label>
            </div>
        </div>

        <!-- Add Participant -->
        <div class="form-group">
            <label>Add Participant</label>
            <input type="text" id="userId" placeholder="Paste user ObjectId">
            <input type="text" id="username" placeholder="Username (for display)" style="margin-top: 10px;">
            <button type="button" class="add-btn" onclick="addParticipant()">Add User</button>
        </div>

        <!-- Participants List -->
        <div id="participantsList"></div>

        <!-- Total Info -->
        <div class="total-info" id="totalInfo">
            Total allocated: <span id="allocatedTotal">0</span> / <span id="expenseTotal">0</span>
        </div>

        <!-- Hidden fields -->
        <input type="hidden" name="participants" id="participantsInput">
        <input type="hidden" name="customSplits" id="customSplitsInput">

        <button type="submit" class="submit-btn">Create Expense</button>
    </form>

    <script>
        let addedParticipants = [];

        document.getElementById('amount').addEventListener('input', updateTotals);

        function addParticipant() {
            const userId = document.getElementById('userId').value.trim();
            const username = document.getElementById('username').value.trim();
            
            if (!userId || !username) {
                alert('Please enter both User ID and Username');
                return;
            }
            
            if (addedParticipants.find(p => p.userId === userId)) {
                alert('User already added');
                return;
            }
            
            addedParticipants.push({
                userId: userId,
                username: username,
                amount: 0
            });
            
            renderParticipants();
            updateTotals();
            
            document.getElementById('userId').value = '';
            document.getElementById('username').value = '';
        }

        function removeParticipant(userId) {
            addedParticipants = addedParticipants.filter(p => p.userId !== userId);
            renderParticipants();
            updateTotals();
        }

        function renderParticipants() {
            const list = document.getElementById('participantsList');
            list.innerHTML = '';
            
            const splitMethod = document.querySelector('input[name="splitMethod"]:checked').value;
            const amount = parseFloat(document.getElementById('amount').value) || 0;
            
            addedParticipants.forEach(p => {
                const row = document.createElement('div');
                row.className = 'participant-row';
                
                let shareInput = '';
                if (splitMethod === 'equal') {
                    const equalShare = addedParticipants.length > 0 ? (amount / addedParticipants.length).toFixed(2) : 0;
                    p.amount = parseFloat(equalShare);
                    shareInput = `<input type="number" value="${equalShare}" readonly style="background: #ecf0f1;">`;
                } else {
                    shareInput = `<input type="number" step="0.01" min="0" value="${p.amount}" onchange="updateCustomAmount('${p.userId}', this.value)">`;
                }
                
                row.innerHTML = `
                    <strong>${p.username}</strong>
                    <small>(${p.userId.substring(0, 8)}...)</small>
                    ${shareInput}
                    <button type="button" class="remove-btn" onclick="removeParticipant('${p.userId}')">Remove</button>
                `;
                list.appendChild(row);
            });
        }

        function updateCustomAmount(userId, value) {
            const participant = addedParticipants.find(p => p.userId === userId);
            if (participant) {
                participant.amount = parseFloat(value) || 0;
                updateTotals();
            }
        }

        function updateSplitMethod() {
            renderParticipants();
            updateTotals();
        }

        function updateTotals() {
            const amount = parseFloat(document.getElementById('amount').value) || 0;
            const allocated = addedParticipants.reduce((sum, p) => sum + (parseFloat(p.amount) || 0), 0);
            
            document.getElementById('expenseTotal').textContent = amount.toFixed(2);
            document.getElementById('allocatedTotal').textContent = allocated.toFixed(2);
            
            const totalInfo = document.getElementById('totalInfo');
            if (Math.abs(allocated - amount) > 0.01 && allocated > 0) {
                totalInfo.style.background = '#fadbd8';
            } else {
                totalInfo.style.background = '#ecf0f1';
            }
        }

        document.querySelector('form').addEventListener('submit', function(e) {
            if (addedParticipants.length === 0) {
                e.preventDefault();
                alert('Please add at least one participant');
                return;
            }
            
            const amount = parseFloat(document.getElementById('amount').value) || 0;
            const splitMethod = document.querySelector('input[name="splitMethod"]:checked').value;
            
            if (splitMethod === 'custom') {
                const allocated = addedParticipants.reduce((sum, p) => sum + (parseFloat(p.amount) || 0), 0);
                if (Math.abs(allocated - amount) > 0.01) {
                    e.preventDefault();
                    alert(`Custom amounts (${allocated.toFixed(2)}) must equal total (${amount.toFixed(2)})`);
                    return;
                }
            }
            
            document.getElementById('participantsInput').value = JSON.stringify(
                addedParticipants.map(p => p.userId)
            );
            
            if (splitMethod === 'custom') {
                document.getElementById('customSplitsInput').value = JSON.stringify(
                    addedParticipants.map(p => ({ user: p.userId, amount: p.amount }))
                );
            } else {
                document.getElementById('customSplitsInput').value = '[]';
            }
        });
    </script>
</body>
</html>